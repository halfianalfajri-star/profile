            <i class="fa-solid fa-pen-to-square icon"></i>
            <h2>Konfirmasi & Doa</h2>
            <p>Berikan doa restu & konfirmasi kehadiran Anda</p>
        </div>

        <!-- Form RSVP -->
        <form class="rsvp-form" id="rsvpForm" onsubmit="submitRSVP(event)">
            <div class="form-group">
                <label>Nama Lengkap</label>
                <input type="text" class="form-control" id="guestName" placeholder="Masukkan nama Anda" required>
            </div>
            <div class="form-group">
                <label>Konfirmasi Kehadiran</label>
                <select class="form-control" id="guestStatus" required>
                    <option value="Hadir">Ya, Saya Akan Hadir</option>
                    <option value="Tidak Hadir">Maaf, Tidak Bisa Hadir</option>
                </select>
            </div>
            <div class="form-group">
                <label>Pesan & Doa Restu</label>
                <textarea class="form-control" id="guestMessage" rows="3" placeholder="Tuliskan ucapan atau doa untuk kedua mempelai..." required></textarea>
            </div>
            <button type="submit" class="btn-submit">Kirim Ucapan & Konfirmasi</button>
        </form>

        <!-- List Ucapan -->
        <div class="wishes-list" id="wishesList">
            <div class="wish-item">
                <strong>Andi & Keluarga</strong>
                Selamat menempuh hidup baru Romeo & Juliet! Semoga menjadi keluarga yang sakinah, mawaddah, warahmah. Selamat mendaki bahtera rumah tangga!
            </div>
            <div class="wish-item">
                <strong>Budi Tim Pendaki</strong>
                Happy Wedding Brother! Semoga makin solid dan perjalanan rumah tangganya selalu dalam lindungan Allah SWT.
            </div>
        </div>
    </section>

    <!-- THANKS SECTION -->
    <section class="thanks-section" id="thanks">
        <div>
            <i class="fa-solid fa-mountain" style="font-size: 3.5rem; color: var(--accent-gold); margin-bottom: 20px;"></i>
        </div>
        <h2>Terima Kasih</h2>
        <p>Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.</p>
        
        <p style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--accent-gold);">
            Kami Yang Berbahagia,<br>
            <strong>Romeo & Juliet</strong>
        </p>
    </section>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        function openInvitation() {
            document.getElementById('opening-screen').classList.add('opened');
            document.getElementById('navbar').classList.add('show');
            
            const music = document.getElementById('bgMusic');
            music.play().catch(e => console.log("Autoplay blocked by browser policy"));
        }

        let isPlaying = true;
        function toggleMusic() {
            const music = document.getElementById('bgMusic');
            const btn = document.getElementById('musicBtn');
            if (isPlaying) {
                music.pause();
                btn.innerHTML = '<i class="fa-solid fa-music-slash"></i>';
            } else {
                music.play();
                btn.innerHTML = '<i class="fa-solid fa-music"></i>';
            }
            isPlaying = !isPlaying;
        }

        const eventDate = new Date("Oct 24, 2026 08:00:00").getTime();
        
        setInterval(function() {
            const now = new Date().getTime();
            const distance = eventDate - now;

            if (distance > 0) {
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                document.getElementById("days").innerText = days < 10 ? '0' + days : days;
                document.getElementById("hours").innerText = hours < 10 ? '0' + hours : hours;
                document.getElementById("minutes").innerText = minutes < 10 ? '0' + minutes : minutes;
                document.getElementById("seconds").innerText = seconds < 10 ? '0' + seconds : seconds;
            }
        }, 1000);

        function submitRSVP(event) {
            event.preventDefault();
            const name = document.getElementById('guestName').value;
            const message = document.getElementById('guestMessage').value;

            const wishesList = document.getElementById('wishesList');
            const newWish = document.createElement('div');
            newWish.className = 'wish-item';
            newWish.innerHTML = `<strong>${name}</strong>${message}`;

            wishesList.prepend(newWish);
            document.getElementById('rsvpForm').reset();
            alert('Terima kasih! Pesan dan konfirmasi Anda telah terkirim.');
        }

        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('.nav-link');

        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (pageYOffset >= sectionTop - 150) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href').includes(current)) {
                    link.classList.add('active');
                }
            });
        });
    </script>
</body>
</html>
